<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="BlockedTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/blocked_bg</item>
        <item name="android:statusBarColor">@color/blocked_bg</item>
        <item name="android:navigationBarColor">@color/blocked_bg</item>
    </style>
</resources>
